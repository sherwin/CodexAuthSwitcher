{
  "name": "codex-auth-switcher-proxy",
  "version": "1.1.0",
  "private": true,
  "description": "Cross-platform Codex account manager and local Responses proxy",
  "author": "Codex Auth Switcher contributors",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "electron .",
    "proxy": "node proxy/server.mjs serve",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node scripts/run-desktop-smoke.cjs",
    "refresh-auth": "node scripts/refresh-auth-service.mjs",
    "setup": "node proxy/server.mjs configure",
    "build:icons": "node scripts/generate-icons.cjs",
    "prepack": "npm run build:icons",
    "predist": "npm run build:icons",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "proper-lockfile": "4.1.2",
    "sql.js": "^1.15.1",
    "undici": "6.29.0"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.codexauthswitcher.app",
    "productName": "Codex Auth Switcher",
    "files": ["electron/**/*", "proxy/**/*", "package.json"],
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.developer-tools", "icon": "electron/assets/icon.icns" },
    "win": { "target": ["nsis", "zip"], "icon": "electron/assets/icon.ico" },
    "linux": { "target": ["AppImage", "deb"], "icon": "electron/assets/icon.png" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Codex Auth Switcher" }
  }
}
