{
  "name": "codex-auth-switcher-proxy",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "electron .",
    "proxy": "node proxy/server.mjs serve",
    "test": "node --test tests/*.test.mjs",
    "setup": "node proxy/server.mjs configure",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "proper-lockfile": "4.1.2",
    "undici": "6.29.0"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.sherwin.codex-auth-switcher.electron",
    "productName": "Codex Auth Switcher",
    "files": ["electron/**/*", "proxy/**/*", "package.json"],
    "mac": { "target": "dir", "category": "public.app-category.developer-tools" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}
